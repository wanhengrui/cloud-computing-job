# Copy to node-inventory.env (never commit the real one) and fill in the
# private IPs of the three CVMs. This is the same shape the course template
# uses; the node processes read these variables at startup, so the image and
# the binaries stay identical on every machine.
#
# node_id values are FNV-1a 32 of the node names:
#   node-a -> 79934867  (0x04c3b593)
#   node-b -> 96712486  (0x05c3b726)
#   node-c -> 113490105 (0x06c3b8b9)
# Any three distinct uint32 values work; these keep the ring reproducible.

NODE_A_NAME=node-a
NODE_A_HOST=10.1.0.2
NODE_A_PORT=19001
NODE_A_ID=79934867

NODE_B_NAME=node-b
NODE_B_HOST=10.1.0.3
NODE_B_PORT=19001
NODE_B_ID=96712486

NODE_C_NAME=node-c
NODE_C_HOST=10.1.0.4
NODE_C_PORT=19001
NODE_C_ID=113490105

# Where the 1A services (pricing + trip) run. Defaults to the node-b host when
# scripts/gen-cloud-config.sh generates the cloud yaml.
TRIP_HOST=10.1.0.3
PRICING_HOST=10.1.0.3
